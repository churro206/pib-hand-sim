    <origin xyz="0.045 0.0018 0" rpy="0 0 -1.5708"/>
    <parent link="urdf_thumb_proximal_2"/>
    <child link="urdf_thumb_tip_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_thumb_rotator_right to urdf_thumb_proximal_2 -->
  <joint name="thumb_right_proximal" type="revolute">
    <origin xyz="0.0257187 -0 -7.51193e-05" rpy="-1.04237 0.216545 0.024862"/>
    <parent link="urdf_thumb_rotator_right"/>
    <child link="urdf_thumb_proximal_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_palm_right to urdf_thumb_rotator_right -->
  <joint name="thumb_right_rotator" type="revolute">
    <origin xyz="0.0291072 -0.0018 -0.0246013" rpy="0 1.34019 3.14159"/>
    <parent link="urdf_palm_right"/>
    <child link="urdf_thumb_rotator_right"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_forearm_right to urdf_palm_right -->
  <joint name="wrist_right" type="revolute">
    <origin xyz="0 -0 -0.1544" rpy="-3.14159 1.5708 0"/>
    <parent link="urdf_forearm_right"/>
    <child link="urdf_palm_right"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.5708" upper="0.523599"/>
  </joint>
  <!-- Joint from urdf_elbow_lower_2 to urdf_forearm_right -->
  <joint name="forearm_right" type="revolute">
    <origin xyz="0.0767703 0.0464077 -0.0375418" rpy="-1.5708 -0 2.35619"/>
    <parent link="urdf_elbow_lower_2"/>
    <child link="urdf_forearm_right"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.5708" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_elbow_upper_2 to urdf_elbow_lower_2 -->
  <joint name="elbow_right" type="revolute">
    <origin xyz="-0.0379 -0.021 -0.0763379" rpy="-3.14159 1.5708 0"/>
    <parent link="urdf_elbow_upper_2"/>
    <child link="urdf_elbow_lower_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.785398" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_shoulder_horizontal_2 to urdf_elbow_upper_2 -->
  <joint name="upper_arm_right" type="revolute">
    <origin xyz="0 -0.14 -0.0372" rpy="-1.5708 -0 0"/>
    <parent link="urdf_shoulder_horizontal_2"/>
    <child link="urdf_elbow_upper_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.5708" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_shoulder_vertical_2 to urdf_shoulder_horizontal_2 -->
  <joint name="shoulder_horizontal_right" type="revolute">
    <origin xyz="-0.0374954 0 -0.059" rpy="1.5708 0 -1.5708"/>
    <parent link="urdf_shoulder_vertical_2"/>
    <child link="urdf_shoulder_horizontal_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_body to urdf_shoulder_vertical_2 -->
  <joint name="shoulder_vertical_right" type="revolute">
    <origin xyz="-0.16 -0.0949996 -0.324501" rpy="-3.14159 -1.5708 0"/>
    <parent link="urdf_body"/>
    <child link="urdf_shoulder_vertical_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.5708" upper="1.5708"/>
  </joint>
  <!-- Joint from urdf_base_link to urdf_body -->
  <joint name="body" type="fixed">
    <origin xyz="-9.8273e-07 -0.0876932 0.461" rpy="3.14159 0 -0"/>
    <parent link="urdf_base_link"/>
    <child link="urdf_body"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       ros2_control Hardware Interface
       topic_based_ros2_control liest /pib/hw/joint_states von Isaac
       und schreibt /pib/hw/joint_commands nach Isaac.
       Winkel in Radiant (ros2_control-Standard).
  ══════════════════════════════════════════════════════════════════ -->
  <ros2_control name="pib_hw" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/pib/hw/joint_commands</param>
      <param name="joint_states_topic">/pib/hw/joint_states</param>
    </hardware>

    <!-- Körper (14 DOFs) -->
    <joint name="head_horizontal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="head_vertical">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="shoulder_vertical_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="shoulder_horizontal_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="upper_arm_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="elbow_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="forearm_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wrist_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="shoulder_vertical_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="shoulder_horizontal_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="upper_arm_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="elbow_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="forearm_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wrist_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- Linke Hand (15 DOFs) -->
    <joint name="thumb_left_rotator">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="thumb_left_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="thumb_left_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_left_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_left_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_left_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_left_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_left_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_left_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_left_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_left_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_left_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_left_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_left_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_left_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- Rechte Hand (15 DOFs) -->
    <joint name="thumb_right_rotator">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="thumb_right_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="thumb_right_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_right_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_right_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="index_right_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_right_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_right_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="middle_right_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_right_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_right_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="ring_right_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_right_proximal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_right_distal">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="pinky_right_tip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

  </ros2_control>

</robot>
